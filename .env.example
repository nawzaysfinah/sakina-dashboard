# Supabase — same project as sakina-bot
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Baby ID — the Telegram user ID of the primary caregiver.
# Find it: Supabase → Table Editor → users → copy the "id" value.
BABY_ID=123456789

# Dashboard password gate
DASHBOARD_PASSWORD=choose_a_passphrase
# A random secret used in the auth cookie (any long random string)
DASHBOARD_TOKEN=some_random_32_char_string_here
